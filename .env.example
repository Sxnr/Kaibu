# Copia este archivo como ".env.local" y completa con los datos de tu proyecto Supabase.
# Ambos valores son PÚBLICOS (la seguridad la da Row Level Security en la base de datos).
# Nunca pongas aquí la "service_role key" ni claves de IA.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: registro de errores en producción (Sentry, plan gratis). La DSN también es pública.
VITE_SENTRY_DSN=
