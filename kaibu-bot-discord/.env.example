# Copia este archivo como .env (solo en tu PC) o pon estas variables en Render → Environment.
# Nunca subas el .env real a GitHub.

# Discord Developer Portal → tu aplicación
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# ID de tu servidor (clic derecho en el ícono del servidor → Copiar ID). Hace que los comandos aparezcan al instante.
DISCORD_GUILD_ID=

# Supabase → Project Settings → API. La service_role solo va aquí, nunca en la app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: crear issues en GitHub desde el triaje (token fine-grained con "Issues: Read and write")
GITHUB_TOKEN=
GITHUB_REPO=Sxnr/Kaibu

# Opcional: link del formulario de Google con la encuesta completa
FORM_URL=

PORT=8000
